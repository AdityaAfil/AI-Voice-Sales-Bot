# Keep this key on the server only. Never paste it into frontend source code.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Warm, expressive OpenAI voice (other supported voices can be selected here).
OPENAI_TTS_VOICE=marin
PORT=8787
# For persistent hosting, point DATA_DIR to a persistent disk directory.
DATA_DIR=./server/data
